    Rel(agent_system, market_data, "Pulls OHLCV, fundamentals, technicals")
    Rel(agent_system, llm, "Requests stock scoring")
    Rel(agent_system, email, "Sends email alerts")
    Rel(agent_system, broker, "Executes live trades (future)")
```

## Container Diagram

```mermaid
C4Container
    title Momentum Stock Agent - Container Diagram (Data Pipeline)

    Person(user, "Trader / Operator", "Schedules pipeline, reviews alerts, manages trades")

    System_Boundary(pipeline, "Momentum Stock Agent") {
        Container(orchestrator, "orchestrator.py", "Python", "Schedules and orchestrates the 5-agent pipeline")
        Container(extraction, "extraction_agent.py", "Python", "Aggregates watchlist from multiple sources")
        Container(scanner, "scanner_agent.py", "Python", "Fetches OHLCV and computes technicals")
        Container(analyst, "analyst_agent.py", "Python", "Scores using CANSLIM + Weinstein Stage + VCP")
        Container(alerting, "alert_agent.py", "Python", "Filters signals, enforces cooldown, sends alerts")
        Container(trader, "trader_agent.py", "Python", "Records trades, computes P&L (record-only currently)")
    }

    Container_Ext(watchlist_src, "Watchlist Sources", "TradingView, StockTwits, WhaleWisdom, Congress")
    Container_Ext(market_data, "Market Data APIs", "yfinance, FMP, Alpha Vantage")
    Container_Ext(llm_server, "Foundry Local LLM", "phi-4-mini scoring (optional fallback)")
    Container_Ext(smtp_svc, "Email Service", "SMTP alert delivery")
    Container_Ext(alpaca, "Alpaca Broker API", "Live order execution (future)")

    Rel(user, orchestrator, "Triggers pipeline run or scheduling")
    Rel(orchestrator, extraction, "run()")
    Rel(orchestrator, scanner, "run(extraction results)")
    Rel(orchestrator, analyst, "run(scan results)")
    Rel(orchestrator, alerting, "run(analysis results)")
    Rel(orchestrator, trader, "record trades from alerts")

    Rel(extraction, watchlist_src, "Fetches tickers from multiple sources")
    Rel(scanner, market_data, "Downloads OHLCV, fundamentals, Congress data")
    Rel(analyst, llm_server, "Optional: requests CANSLIM score")
    Rel(alerting, smtp_svc, "Sends email alerts for BUY signals")
    Rel(trader, alpaca, "Future: executes live orders")
```

## Component Diagram - 5-Agent Pipeline

```mermaid
C4Component
    title Momentum Stock Agent - Component Diagram

    Container(orchestrator, "orchestrator.py", "Agent framework", "Orchestration") {
        Component(schedule, "APScheduler", "Market hours trigger (9:30-4:00 ET weekdays)")
        Component(pipeline_run, "run_pipeline()", "Executes Extraction → Scanner → Analyst → Alert → Trader")
        Component(error_handle, "Error handling & logging", "Catches failures, logs to pipeline_runs.csv")
    }

    Container(extraction, "extraction_agent.py", "Multi-source aggregation", "Watchlist building") {
        Component(tv_src, "TradingView screener", "fetch_tv_screener_tickers()")
        Component(st_src, "StockTwits source", "load_source_map()")
        Component(ww_src, "WhaleWisdom context", "load_ww_context()")
        Component(dedup, "Deduplication & union", "Merges sources, removes duplicates")
        Component(qual_gate, "Quality gates", "Filters by volume, price thresholds")
    }

    Container(scanner, "scanner_agent.py", "Technical analysis", "Data enrichment") {
        Component(fetch_prices, "fetch_stock_data()", "yfinance OHLCV + 252-day history")
        Component(tech_ind, "compute_technicals()", "SMA10/30/50/150/200, RSI14, ATR14, volume, rel_strength")
        Component(vcp_data, "VCP pivot detection", "high_base (50d max), handle_low (15d min)")
        Component(scan_run, "scan_watchlist()", "Returns list[StockRecord] with all metrics")
    }

    Container(analyst, "analyst_agent.py", "Setup scoring", "Analysis & signals") {
        Component(vcp_run, "_run_vcp_analysis()", "Calls vcp-screener skill calculators")
        Component(canslim, "_canslim_fundamental_score()", "Scores C/A/N/S/L/I/M (7-component, 14-point total)")
        Component(stage, "_stage_classify()", "Weinstein Stage 1-4 classification via SMA levels")
        Component(entry_zone, "_execution_state_to_entry_zone()", "Maps VCP state → broken_out/approaching/extended/far")
        Component(price_calc, "_run_btp_pricing()", "Calculates entry, stop loss, R-multiples via risk_calculator")
        Component(score_run, "score_stock()", "Returns StockAnalysis with score/stage/entry/stop")
    }

    Container(alerting, "alert_agent.py", "Notification & cooldown", "Alert delivery") {
        Component(trigger, "alert_trigger()", "Detects fresh_breakout OR multiyear_breakout")
        Component(cooldown, "was_recently_alerted()", "24-hour per-ticker cooldown enforcement")
        Component(record, "record_alert()", "Persists alert to alerts.db with metadata")
        Component(email_fmt, "format_alert_html()", "Builds email with CANSLIM table, narrative, risk")
        Component(email_send, "send_email()", "SMTP delivery with Yahoo Finance links")
    }

    Container(trader, "trader_agent.py", "Trade recording", "Position tracking") {
        Component(record_buy, "record_buy()", "Logs BUY to trades.db with entry/stop")
        Component(record_sell, "record_sell()", "Logs SELL to trades.db, updates cash")
        Component(cash_mgr, "Cash management", "get_cash() / set_cash() per portfolio")
        Component(pnl_calc, "Positions query", "get_trade_history() for P&L calculation")
    }

    Rel(schedule, pipeline_run, "Triggers at market open")
    Rel(pipeline_run, extraction, "Builds watchlist")
    Rel(pipeline_run, scanner, "Scans tickers")
    Rel(pipeline_run, analyst, "Analyzes scans")
    Rel(pipeline_run, alerting, "Filters & alerts")
    Rel(pipeline_run, trader, "Records trades")
    Rel(pipeline_run, error_handle, "Logs run metrics")

    Rel(extraction, dedup, "Merges sources")
    Rel(dedup, qual_gate, "Applies filters")
    Rel(scanner, fetch_prices, "Gets OHLCV")
    Rel(scanner, tech_ind, "Computes indicators")
    Rel(scanner, vcp_data, "Calculates pivots")
    Rel(analyst, vcp_run, "Calls skill")
    Rel(analyst, canslim, "Fundamental score")
    Rel(analyst, stage, "Stage classification")
    Rel(analyst, entry_zone, "Entry zone mapping")
    Rel(analyst, price_calc, "Trade pricing")
    Rel(alerting, trigger, "Checks signal")
    Rel(alerting, cooldown, "Enforces limit")
    Rel(alerting, record, "Saves to DB")
    Rel(alerting, email_fmt, "Formats HTML")
    Rel(alerting, email_send, "Sends email")
    Rel(trader, record_buy, "Logs buy")
    Rel(trader, record_sell, "Logs sell")
    Rel(trader, cash_mgr, "Manages cash")
    Rel(trader, pnl_calc, "Calculates P&L")
```
