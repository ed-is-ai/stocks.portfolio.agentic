# Copy this to .env and fill in your values

# --- Financial Modeling Prep (VCP screener) ---
# Get key at: https://financialmodelingprep.com/developer/docs
FMP_API_KEY=                      # required for vcp_screener source

# --- Alpha Vantage (fundamental data fallback) ---
# Free tier: 25 API calls/day, 5 calls/min
# Get key at: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=             # leave blank to disable AV fallback

# --- Email alerts ---
EMAIL_USER=you@gmail.com          # sending address
EMAIL_PASSWORD=your_app_password  # Gmail: generate at myaccount.google.com/apppasswords
EMAIL_TO=you@gmail.com            # recipient (can be the same address)
EMAIL_HOST=smtp.gmail.com         # change for Outlook: smtp.office365.com
EMAIL_PORT=587                    # 587 = STARTTLS (recommended); 465 = SSL
