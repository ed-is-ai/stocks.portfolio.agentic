# Copy this to .env and fill in your values

# --- Financial Modeling Prep (VCP screener) ---
# Get key at: https://financialmodelingprep.com/developer/docs
FMP_API_KEY=                      # required for vcp_screener source

# --- Alpha Vantage (fundamental data fallback) ---
# Free tier: 25 API calls/day, 5 calls/min
# Get key at: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=             # leave blank to disable AV fallback

# --- Email alerts ---
EMAIL_USER=you@gmail.com          # sending address
EMAIL_PASSWORD=your_app_password  # Gmail: generate at myaccount.google.com/apppasswords
EMAIL_TO=you@gmail.com            # recipient (can be the same address)
EMAIL_HOST=smtp.gmail.com         # change for Outlook: smtp.office365.com
EMAIL_PORT=587                    # 587 = STARTTLS (recommended); 465 = SSL

# StockTwits weekly "Top 25" email source (#137) — reuses EMAIL_USER/PASSWORD.
# The lists are images, so ANTHROPIC_API_KEY (below) is required to read them.
# All optional: if unset, extraction falls back to config/stocktwits_watchlist.json.
EMAIL_IMAP_HOST=imap.gmail.com    # change for Outlook: outlook.office365.com
EMAIL_IMAP_PORT=993              # 993 = IMAP over SSL
STOCKTWITS_EMAIL_FROM=stocktwits.com        # IMAP FROM filter
STOCKTWITS_EMAIL_SUBJECT=Stocktwits Top 25  # IMAP SUBJECT filter

# --- Analyst LLM scoring (Foundry Local) ---
# Off by default: the analysis loop scores tickers sequentially, so an LLM
# call per ticker makes large scans much slower. Set to true to opt in.
ANALYST_LLM_SCORING_ENABLED=false
